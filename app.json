{
  "expo": {
    "name": "早睡自救局",
    "slug": "my-sleep-dream",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "mysleepdream",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "expo-notifications",
      "./plugins/withSleepAudioMonitoring"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/ui/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#090A19"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "用于在你主动开启睡眠监听后，只在本机记录昨晚的声音摘要。"
      }
    },
    "android": {
      "package": "com.mysleepdream.app",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090A19"
      }
    },
    "extra": {
      "demoMode": false,
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4cdd1745-0450-43c7-8df3-90c3b5ed2113"
      }
    },
    "owner": "egottkxkl"
  }
}
