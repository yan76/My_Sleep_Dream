{
  "expo": {
    "name": "早睡自救局",
    "slug": "my-sleep-dream",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mysleepdream",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/ui/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#090A19"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "用于在你主动开启睡眠监听后，只在本机记录昨晚的声音摘要。"
      }
    },
    "android": {
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#090A19"
      }
    }
  }
}
